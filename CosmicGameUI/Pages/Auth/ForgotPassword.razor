@page "/forgot-password"
@inject IAuthService AuthService
@inject MudBlazor.ISnackbar Snackbar
@using CosmicGameUI.Services

<PageTitle>Forgot Password – Cosmic Birthchart</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="cosmic-logo">
            <svg width="48" height="48" viewBox="0 0 60 60" fill="none">
                <circle cx="30" cy="30" r="28" stroke="#7c4dff" stroke-width="2"/>
                <circle cx="30" cy="30" r="6" fill="#7c4dff"/>
            </svg>
            <h1>Reset Password</h1>
            <p>We'll send a reset link to your email</p>
        </div>

        @if (!_sent)
        {
            <MudBlazor.MudTextField @bind-Value="_email"
                           Label="Email Address"
                           Variant="MudBlazor.Variant.Outlined"
                           InputType="MudBlazor.InputType.Email"
                           Adornment="MudBlazor.Adornment.Start"
                           AdornmentIcon="@MudBlazor.Icons.Material.Filled.Email"
                           Class="mb-4" />

            <MudBlazor.MudButton Variant="MudBlazor.Variant.Filled"
                        Color="MudBlazor.Color.Primary"
                        FullWidth="true"
                        Size="MudBlazor.Size.Large"
                        OnClick="@HandleForgotPassword"
                        Disabled="@_loading"
                        Style="border-radius:8px;padding:12px;">
                @if (_loading) { <MudBlazor.MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Class="mr-2" /> }
                Send Reset Link
            </MudBlazor.MudButton>
        }
        else
        {
            <MudBlazor.MudAlert Severity="MudBlazor.Severity.Success" Class="mb-4">
                Reset link sent! Check your inbox.
            </MudBlazor.MudAlert>
        }

        <div style="margin-top:16px;text-align:center;">
            <MudBlazor.MudLink Href="/login" Color="MudBlazor.Color.Primary">Back to Sign In</MudBlazor.MudLink>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private bool _loading;
    private bool _sent;

    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _loading = true;
        try
        {
            var result = await AuthService.ForgotPasswordAsync(_email);
            _sent = result?.success == true;
            if (!_sent) Snackbar.Add(result?.message ?? "Failed to send reset email.", MudBlazor.Severity.Error);
        }
        finally { _loading = false; }
    }
}
