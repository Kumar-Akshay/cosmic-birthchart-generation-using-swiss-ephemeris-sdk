@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <MudBlazor.MudText Typo="MudBlazor.Typo.h6" Class="pa-4">You are not authorized to view this page.</MudBlazor.MudText>
                    }
                </NotAuthorized>
                <Authorizing>
                    <Components.Shared.LoadingSpinner Message="Verifying session..." />
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <PageTitle>Not Found</PageTitle>
            <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
                <div style="text-align:center;padding:60px;">
                    <MudBlazor.MudText Typo="MudBlazor.Typo.h1" Style="color:var(--cosmic-primary-light)">404</MudBlazor.MudText>
                    <MudBlazor.MudText Typo="MudBlazor.Typo.h5" Style="color:var(--cosmic-text-muted)">The star you seek is not in this galaxy.</MudBlazor.MudText>
                    <MudBlazor.MudButton Href="/" Variant="MudBlazor.Variant.Filled" Color="MudBlazor.Color.Primary" Class="mt-4">Return Home</MudBlazor.MudButton>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
